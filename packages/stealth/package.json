{
  "name": "@ckb-ccc/stealth",
  "version": "0.1.0",
  "description": "CCC support for Obscell stealth addresses on CKB",
  "author": "willy264 <daviswill264@gmail.com>",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/ckb-devrel/ccc",
  "repository": { "type": "git", "url": "git://github.com/ckb-devrel/ccc.git" },
  "sideEffects": false,
  "main": "./dist.commonjs/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist.commonjs/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.mjs", "require": "./dist.commonjs/index.js" },
    "./advanced": { "import": "./dist/advanced.mjs", "require": "./dist.commonjs/advanced.js" },
    "./advancedBarrel": { "import": "./dist/advancedBarrel.mjs", "require": "./dist.commonjs/advancedBarrel.js" },
    "./barrel": { "import": "./dist/barrel.mjs", "require": "./dist.commonjs/barrel.js" },
    "./experimental": { "import": "./dist/experimental.mjs", "require": "./dist.commonjs/experimental.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown", "test": "vitest", "test:ci": "vitest run",
    "lint": "tsc --noEmit && eslint ./src", "format": "prettier --write . && eslint --fix ./src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1", "@types/node": "^26.0.0", "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.1", "eslint-plugin-prettier": "^5.5.6", "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0", "tsdown": "^0.23.0",
    "@typescript/native": "npm:typescript@^7.0.2", "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1", "vitest": "^4.1.9"
  },
  "dependencies": { "@ckb-ccc/core": "workspace:*", "@noble/curves": "^2.4.0", "@noble/hashes": "^2.4.0", "bech32": "^2.0.0" },
  "publishConfig": { "access": "public" },
  "packageManager": "pnpm@11.8.0"
}
