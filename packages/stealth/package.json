{
  "name": "@ckb-ccc/stealth",
  "version": "0.0.0-demo",
  "private": true,
  "description": "Private stealth-address prototype for the CCC Incognito visual demo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:ci": "pnpm test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ckb-ccc/core": "workspace:*",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
